classdef RigidBody
    properties
        id

        % Physical properties
        size        = [0 0 0]';
        mass        = [];
        COM         = [0 0 0]';
        inertia     = zeros(3,3);

        % Graphics
      visualization = struct([]);
      graphics      = struct([]);

        % Markers
        markers     = struct([]);

        % Configuration
        position    = [0 0 0]';
        local_offset= [0 0 0]';

        rotation    = [0 0 0]';
        rotMatrix   = eye(3);

        % Velocities
        velocity           = [0 0 0]';
        omega              = [0 0 0]';
        drotMatrix         = eye(3);


        % Acceleration
        acceleration       = [0 0 0]'; 
        alpha              = [0 0 0]'; 
        ddrotMatrix        = eye(3);

        % External forces
        force        = [0 0 0]';
        moment       = [0 0 0]';
    end

methods

%% Assign physical properties
function body = RigidBody(varargin)
            % Constructor (replaces CreateRigidBody)

    for i = 1:2:length(varargin)
        name  = varargin{i};
        value = varargin{i+1};

        switch name
            case 'mass'
                body.mass = value;
            case 'COM'
                body.COM = value;
            case 'position'
                body.position = value;
            case 'inertia'
                 if isempty(body.inertia)
                     body.inertia = (body.mass/12)*diag([body.size(2)^2 + body.size(3)^2, ...
                                                        body.size(1)^2 + body.size(3)^2, ...
                                                        body.size(1)^2 + body.size(2)^2]);
                 else
                     body.inertia = value;
                 end

            case 'size'
                body.size = value;
            case 'rotMatrix'
                body.rotMatrix = value;
            case 'visualization'
                body.visualization = value;
                body.graphics      = body.plot_body();
        end
    end
end

%% Position
function rj = positionVec(body, uVec )
    rj      = body.position(:)+body.rotMatrix*uVec(:);
end 

%% Velocity
function dotrj = velocityVec(body, uVec )
     dotrj     = body.velocity(:)+cross(body.omega, uVec);
end 

%% Acceleration
function ddotrj = accVec(body, uVec )
    ddotrj      = body.acceleration(:)+...
                        cross(body.alpha, uVec(:))+...
                         cross(body.omega, cross(body.omega, uVec(:))) ;
end 

%% Markers


%% Assign graphics
function g = plot_body(body)
        size    = body.size;
        L       = size(1);
        H       = size(2);
        r       = H/2;

        p0      = body.positionVec(body.local_offset(:));
        pcm     = body.position(:)+body.rotMatrix*body.COM(:);
        pend    = body.position(:)+body.rotMatrix*[body.size(1);0;0];

    core_line   = [p0  pend]';

    poly        = polybuffer(core_line(:,1:2), 'lines', r, 'JointType', 'round');

    g.type      = 'bar2D';
    g.vertices  = poly.Vertices;

    if isfield(body.visualization, 'show') && body.visualization.show

        if isfield(body.visualization, 'color')
            c = body.visualization.color;
        else
            c = [0 0.4470 0.7410]; % default color
        end


        figure;
        fill(g.vertices(:,1), g.vertices(:,2), c, 'FaceAlpha', 0.5);
        hold on 
        axis equal;
        axis_len    = 0.1 * L;
        local_x     = body.rotMatrix(1:2, 1)*axis_len;
        local_y     = body.rotMatrix(1:2, 2)*axis_len;
        
        

        quiver(p0(1), p0(2), local_x(1), local_x(2), 0, 'r', 'LineWidth', 1.5, 'MaxHeadSize', 0.5);
        quiver(p0(1), p0(2), local_y(1), local_y(2), 0, 'g', 'LineWidth', 1.5, 'MaxHeadSize', 0.5);
        fill(p0(1) + r, p0(2) + r, 'k', 'EdgeColor', 'none');
        plot(p0(1) + r, p0(2) + r, 'k', 'LineWidth', 1);
        hold on 
        

        quiver(pcm(1), pcm(2), local_x(1), local_x(2), 0, 'r', 'LineWidth', 1.5, 'MaxHeadSize', 0.5);
        quiver(pcm(1), pcm(2), local_y(1), local_y(2), 0, 'g', 'LineWidth', 1.5, 'MaxHeadSize', 0.5);

        hold on
        % xline(0, 'k', 'LineWidth', 2);
        % yline(0, 'k', 'LineWidth', 2);
        % xlabel('X', 'FontSize', 12, 'FontWeight', 'bold');
        % ylabel('Y', 'FontSize', 12, 'FontWeight', 'bold');
        
        xlim([-2*L, 2*L]);
        ylim([-2*L, 2*L]);

        grid on;
        hold off;
    
    end

end

end


end


